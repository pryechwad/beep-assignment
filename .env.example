# ---- Core infrastructure ----
NODE_ENV=development
# connection_limit: per-process pool; connect/pool timeouts tolerate brief Docker/network stalls
DATABASE_URL=postgresql://beep:beep_dev_password@localhost:5442/beep?connection_limit=10&connect_timeout=20&pool_timeout=20
# Used by API integration tests only (dropped/recreated by the test setup)
TEST_DATABASE_URL=postgresql://beep:beep_dev_password@localhost:5442/beep_test
REDIS_URL=redis://localhost:6389

# ---- API ----
API_PORT=4100
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:5180
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Initial admin account created by `npm run db:seed` (only if it does not exist)
ADMIN_EMAIL=admin@beep.local
ADMIN_PASSWORD=

# ---- AI providers (server-side only; never prefix with VITE_) ----
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Order in which providers are tried for classification. Providers without a key are skipped.
AI_PROVIDER_ORDER=gemini,openai,groq
# Provider used for embeddings (semantic duplicate detection). Leave blank to disable layer-3 semantic matching.
AI_EMBEDDING_PROVIDER=gemini
# Daily cap on LLM classification calls (cost/quota guard). 0 = unlimited.
AI_MAX_LLM_CLASSIFICATIONS_PER_DAY=400
# LLM classifications per minute. Groq free tier allows ~2-4; raise for paid Gemini/OpenAI keys.
# Every post gets an LLM tag (early-career first). false = senior roles stay rules-only (cheaper).
AI_LLM_FOR_ALL=true
# Groq models tried in order; each has its own free-tier quota.
AI_GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
AI_CLASSIFY_PER_MINUTE=2

# ---- Scheduler ----
# Cron for the daily pipeline (Asia/Kolkata). Default 06:30 IST.
PIPELINE_CRON=30 6 * * *
PIPELINE_TZ=Asia/Kolkata
LINK_VERIFY_CRON=0 */6 * * *
RECLASSIFY_CRON=15 * * * *
ANALYTICS_CRON=55 23 * * *

# Prisma: disable update/telemetry checks (they stalled CLI runs on this network)
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1
