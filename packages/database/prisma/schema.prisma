// BEEP Job Intelligence — relational model.
//
// Data flow:  JobSource ─▶ RawJob (verbatim source record)
//                              │  normalise + deduplicate
//                              ▼
//                    Job (canonical opportunity) ─▶ JobClassification (versioned AI/rule output)
//                              │                          └▶ AIUsage (tokens, cost)
//                              ├▶ JobLocation / JobSkill (relational facets for filtering)
//                              ├▶ JobDuplicate (dedup decisions + scores)
//                              ├▶ JobVerification (link checks)
//                              └▶ ClassificationAudit (human ground-truth labels)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum SourceAdapterType {
  GREENHOUSE
  LEVER
  ASHBY
}

enum RoleCategory {
  FRONTEND
  BACKEND
  FULL_STACK
  SOFTWARE_ENGINEERING
  AI_ML
  DATA_ENGINEERING
  DATA_SCIENCE
  ANALYTICS
  DEVOPS
  CLOUD
  CYBERSECURITY
  PRODUCT
  DESIGN
  MARKETING
  SALES
  FINANCE
  OPERATIONS
  OTHER
}

enum ExperienceLevel {
  INTERNSHIP
  FRESHER
  ZERO_TO_ONE
  ONE_TO_TWO
  EXPERIENCED
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  INTERNSHIP
  PART_TIME
  CONTRACT
  FREELANCE
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum LocationType {
  CITY
  STATE
  REMOTE
  MULTIPLE
  UNKNOWN
}

enum JobStatus {
  ACTIVE
  CLOSED
}

enum RawJobStatus {
  PENDING
  NORMALIZED
  MERGED
  SKIPPED
  FAILED
}

enum RunTrigger {
  SCHEDULED
  MANUAL
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ClassificationMethod {
  RULES
  LLM
  HYBRID
  MANUAL
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum ValidationStatus {
  VALID
  REPAIRED
  INVALID
}

enum DuplicateLayer {
  SOURCE_ID
  CANONICAL_URL
  NORMALIZED_KEY
  FUZZY
  SEMANTIC
}

enum DuplicateDecision {
  MERGED
  DISTINCT
  NEEDS_REVIEW
}

enum ReviewStatus {
  AUTO
  PENDING
  CONFIRMED
  REJECTED
}

enum AIOperation {
  CLASSIFY
  EMBEDDING
}

enum VerificationOutcome {
  LIVE
  CLOSED
  REDIRECTED
  ERROR
}

enum AdminRole {
  ADMIN
  EVALUATOR
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum EvaluationErrorCategory {
  WRONG_ROLE
  WRONG_CITY
  MISSING_INFORMATION
  INCORRECT_EXPERIENCE
  INCORRECT_ELIGIBILITY
  HALLUCINATED_EXTRACTION
}

// ───────────────────────────── Sources & runs ─────────────────────────────

model Company {
  id             String   @id @default(cuid())
  name           String
  /// lower-cased, legal-suffix-stripped key used for matching ("razorpay")
  normalizedName String   @unique
  slug           String   @unique
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs    Job[]
  sources JobSource[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_name_trgm_idx")
}

model JobSource {
  id                 String            @id // e.g. "greenhouse:stripe"
  adapterType        SourceAdapterType
  name               String
  /// ATS board token / site name used in the public API URL
  boardToken         String
  companyId          String?
  company            Company?          @relation(fields: [companyId], references: [id])
  enabled            Boolean           @default(true)
  /// Max outbound requests per minute to this source
  rateLimitPerMinute Int               @default(30)
  /// Only keep postings whose location matches India (most boards are global)
  indiaOnly          Boolean           @default(true)
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  lastError          String?
  lastHealthCheckAt  DateTime?
  healthy            Boolean?
  /// Postings seen on the last successful run (after the India filter)
  lastRecordCount    Int               @default(0)
  totalDiscovered    Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  rawJobs RawJob[]
  tasks   ScrapeTask[]

  @@unique([adapterType, boardToken])
}

model ScrapeRun {
  id               String     @id @default(cuid())
  correlationId    String     @unique
  trigger          RunTrigger
  status           RunStatus  @default(QUEUED)
  requestedBy      String?
  startedAt        DateTime?
  finishedAt       DateTime?
  sourcesTotal     Int        @default(0)
  sourcesSucceeded Int        @default(0)
  sourcesFailed    Int        @default(0)
  jobsFetched      Int        @default(0)
  jobsNew          Int        @default(0)
  jobsUpdated      Int        @default(0)
  jobsClosed       Int        @default(0)
  error            String?
  createdAt        DateTime   @default(now())

  tasks ScrapeTask[]

  @@index([createdAt])
}

model ScrapeTask {
  id            String    @id @default(cuid())
  runId         String
  run           ScrapeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId      String
  source        JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status        RunStatus @default(QUEUED)
  attempt       Int       @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  pagesFetched  Int       @default(0)
  jobsFetched   Int       @default(0)
  jobsFiltered  Int       @default(0)
  jobsNew       Int       @default(0)
  jobsUpdated   Int       @default(0)
  jobsUnchanged Int       @default(0)
  jobsClosed    Int       @default(0)
  errorMessage  String?

  @@unique([runId, sourceId])
  @@index([sourceId, startedAt])
}

// ───────────────────────────── Raw extraction ─────────────────────────────

/// Verbatim record as fetched from a source. Never edited by normalisation.
model RawJob {
  id                String       @id @default(cuid())
  sourceId          String
  source            JobSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId        String
  title             String
  companyName       String
  locations         String[]
  workplaceType     String?
  employmentType    String?
  department        String?
  descriptionHtml   String?
  descriptionText   String
  postingUrl        String
  applyUrl          String?
  publishedAt       String?
  compensationText  String?
  /// Untouched source payload for audit
  payload           Json
  /// sha256 of the fields that matter; a change triggers re-processing
  contentHash       String
  status            RawJobStatus @default(PENDING)
  processingError   String?
  correlationId     String
  firstSeenAt       DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  /// Set when the posting disappears from its source
  removedAt         DateTime?
  jobId             String?
  job               Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  duplicateDecisions JobDuplicate[]

  @@unique([sourceId, externalId])
  @@index([jobId])
  @@index([status])
}

// ───────────────────────────── Canonical jobs ─────────────────────────────

model Job {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  title            String
  /// lower-cased, punctuation-free title used for dedup keys
  titleKey         String
  description      String
  descriptionHtml  String?
  // Normalised facts extracted deterministically from the source (null when the source is silent)
  locationType     LocationType    @default(UNKNOWN)
  primaryCity      String?
  primaryState     String?
  workMode         WorkMode?
  employmentType   EmploymentType?
  salaryText       String?
  department       String?
  postingUrl       String
  applyUrl         String
  /// Normalised canonical URL (unique per opening)
  canonicalUrl     String          @unique
  /// company + title + primary location key (layer-2 dedup)
  dedupKey         String
  publishedAt      DateTime?
  firstSeenAt      DateTime        @default(now())
  lastSeenAt       DateTime        @default(now())
  closedAt         DateTime?
  status           JobStatus       @default(ACTIVE)
  lastVerifiedAt   DateTime?
  correlationId    String
  // Denormalised from the current classification for fast filtering/sorting
  roleCategory     RoleCategory?
  experienceLevel  ExperienceLevel?
  isFresherEligible Boolean?
  confidenceLevel  ConfidenceLevel?
  classifiedAt     DateTime?
  /// Needs an LLM pass that could not run yet (no provider / daily budget exhausted / provider failure)
  llmPending       Boolean         @default(false)
  /// Generated column (see migrations): weighted tsvector over title (A), department (B), description (C).
  /// Declared here so Prisma migrations never drop it; written only by Postgres.
  searchVector     Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(department, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'C'::\"char\"))"))
  /// Embedding for semantic duplicate detection (768 dims; null until computed)
  embedding        Unsupported("vector(768)")?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  locations      JobLocation[]
  skills          JobSkill[]
  rawJobs         RawJob[]
  classifications JobClassification[]
  duplicatesOf    JobDuplicate[]       @relation("canonical")
  duplicateAsCandidate JobDuplicate[]  @relation("candidate")
  verifications   JobVerification[]
  audits          ClassificationAudit[]
  aiUsage         AIUsage[]

  @@index([status, firstSeenAt])
  @@index([status, publishedAt])
  @@index([companyId])
  @@index([dedupKey])
  @@index([roleCategory])
  @@index([experienceLevel])
  @@index([employmentType])
  @@index([primaryCity])
  @@index([isFresherEligible])
  @@index([llmPending])
  @@index([searchVector], type: Gin)
  @@index([titleKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_titleKey_trgm_idx")
}

model JobLocation {
  id       String  @id @default(cuid())
  jobId    String
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Value exactly as the source wrote it
  raw      String
  city     String?
  state    String?
  country  String?
  isRemote Boolean @default(false)
  position Int     @default(0)

  @@unique([jobId, raw])
  @@index([city])
  @@index([state])
}

model Skill {
  id   String     @id @default(cuid())
  /// Display name ("PostgreSQL")
  name String     @unique
  /// lookup key ("postgresql")
  key  String     @unique
  jobs JobSkill[]
}

model JobSkill {
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  /// "RULES" when matched from the skills dictionary, "LLM" when only the model extracted it
  origin  String
  /// rank by relevance (0 = most relevant)
  rank    Int    @default(0)

  @@id([jobId, skillId])
  @@index([skillId])
}

// ───────────────────────────── Intelligence ─────────────────────────────

model JobClassification {
  id                   String               @id @default(cuid())
  jobId                String
  job                  Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  version              Int
  isCurrent            Boolean              @default(true)
  method               ClassificationMethod
  provider             String?
  model                String?
  promptVersion        String?
  roleCategory         RoleCategory
  experienceLevel      ExperienceLevel
  employmentType       EmploymentType?
  workMode             WorkMode?
  locationType         LocationType
  city                 String?
  state                String?
  isFresherEligible    Boolean
  eligibilityReasoning String
  /// Verbatim quotes from the posting supporting the eligibility decision
  eligibilityEvidence  String[]
  educationRequirement String?
  salaryText           String?
  summary              String?
  skills               String[]
  /// 0–1 composite score from rule/LLM agreement + evidence checks (not a raw LLM probability)
  confidenceScore      Float
  confidenceLevel      ConfidenceLevel
  /// Per-signal breakdown used to compute the score
  confidenceFactors    Json
  validationStatus     ValidationStatus
  validationErrors     String[]
  needsReview          Boolean              @default(false)
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           AdminUser?           @relation("reviewer", fields: [reviewedById], references: [id])
  processingMs         Int?
  correlationId        String
  createdAt            DateTime             @default(now())

  usage  AIUsage[]
  audits ClassificationAudit[]

  @@unique([jobId, version])
  @@index([jobId, isCurrent])
  @@index([needsReview, isCurrent])
  @@index([createdAt])
}

model AIUsage {
  id               String             @id @default(cuid())
  operation        AIOperation
  provider         String
  model            String
  promptVersion    String?
  jobId            String?
  job              Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  classificationId String?
  classification   JobClassification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  correlationId    String
  inputTokens      Int
  outputTokens     Int
  /// true when token counts came from the provider's usage report; false when estimated
  tokensMeasured   Boolean
  latencyMs        Int
  retryCount       Int                @default(0)
  success          Boolean
  errorMessage     String?
  /// computed from measured tokens × the dated price table (see pricingVersion)
  costUsd          Decimal            @db.Decimal(12, 8)
  pricingVersion   String
  createdAt        DateTime           @default(now())

  @@index([createdAt])
  @@index([provider, model])
  @@index([jobId])
}

model JobDuplicate {
  id               String            @id @default(cuid())
  canonicalJobId   String
  canonicalJob     Job               @relation("canonical", fields: [canonicalJobId], references: [id], onDelete: Cascade)
  /// The incoming raw record that was compared against the canonical job
  rawJobId         String
  rawJob           RawJob            @relation(fields: [rawJobId], references: [id], onDelete: Cascade)
  /// When the raw record was kept as its own job, the job it became
  candidateJobId   String?
  candidateJob     Job?              @relation("candidate", fields: [candidateJobId], references: [id], onDelete: SetNull)
  layer            DuplicateLayer
  similarityScore  Float
  /// Per-factor similarity scores (title, company, location, description, semantic)
  factors          Json
  decision         DuplicateDecision
  reviewStatus     ReviewStatus      @default(AUTO)
  reviewedById     String?
  reviewedBy       AdminUser?        @relation("dupReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@unique([canonicalJobId, rawJobId])
  @@index([decision, reviewStatus])
}

model JobVerification {
  id         String              @id @default(cuid())
  jobId      String
  job        Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url        String
  outcome    VerificationOutcome
  httpStatus Int?
  finalUrl   String?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime            @default(now())

  @@index([jobId, checkedAt])
}

// ───────────────────────────── Human evaluation ─────────────────────────────

/// Ground-truth labels entered by a human evaluator for one prediction.
model ClassificationAudit {
  id                 String                    @id @default(cuid())
  jobId              String
  job                Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  classificationId   String
  classification     JobClassification         @relation(fields: [classificationId], references: [id], onDelete: Cascade)
  evaluatorId        String
  evaluator          AdminUser                 @relation("evaluator", fields: [evaluatorId], references: [id])
  trueRole           RoleCategory
  /// null = the posting genuinely does not state a city
  trueCity           String?
  trueExperience     ExperienceLevel
  trueEmployment     EmploymentType?
  trueFresherEligible Boolean
  roleCorrect        Boolean
  cityCorrect        Boolean
  experienceCorrect  Boolean
  employmentCorrect  Boolean
  eligibilityCorrect Boolean
  errorCategories    EvaluationErrorCategory[]
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([classificationId, evaluatorId])
  @@index([jobId])
}

// ───────────────────────────── Admin & ops ─────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  reviewedClassifications JobClassification[]   @relation("reviewer")
  reviewedDuplicates      JobDuplicate[]        @relation("dupReviewer")
  audits                  ClassificationAudit[] @relation("evaluator")
}

/// Persisted warnings/errors from the pipeline (stdout carries the full structured log).
model PipelineLog {
  id            String   @id @default(cuid())
  level         LogLevel
  scope         String
  message       String
  correlationId String?
  runId         String?
  sourceId      String?
  jobId         String?
  rawJobId      String?
  context       Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([correlationId])
}

/// End-of-day snapshot written by the analytics aggregation worker. Used for
/// honest day-over-day comparisons: a KPI shows a delta only if yesterday's row exists.
model DailyMetric {
  date            DateTime @id @db.Date
  activeJobs      Int
  fresherEligible Int
  internships     Int
  companies       Int
  cities          Int
  addedToday      Int
  closedToday     Int
  computedAt      DateTime @default(now())
}
